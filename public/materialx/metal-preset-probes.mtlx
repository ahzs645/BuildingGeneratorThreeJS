    <multiply name="alpha_025_scalar" type="float">
      <input name="in1" type="float" nodename="roughness_025" />
      <input name="in2" type="float" nodename="roughness_025" />
    </multiply>
    <multiply name="alpha_050_scalar" type="float">
      <input name="in1" type="float" nodename="roughness_050" />
      <input name="in2" type="float" nodename="roughness_050" />
    </multiply>
    <multiply name="alpha_075_scalar" type="float">
      <input name="in1" type="float" nodename="roughness_075" />
      <input name="in2" type="float" nodename="roughness_075" />
    </multiply>
    <multiply name="alpha_100_scalar" type="float">
      <input name="in1" type="float" nodename="active_perceptual_roughness" />
      <input name="in2" type="float" nodename="active_perceptual_roughness" />
    </multiply>
    <combine2 name="alpha_025" type="vector2">
      <input name="in1" type="float" nodename="alpha_025_scalar" />
      <input name="in2" type="float" nodename="alpha_025_scalar" />
    </combine2>
    <combine2 name="alpha_050" type="vector2">
      <input name="in1" type="float" nodename="alpha_050_scalar" />
      <input name="in2" type="float" nodename="alpha_050_scalar" />
    </combine2>
    <combine2 name="alpha_075" type="vector2">
      <input name="in1" type="float" nodename="alpha_075_scalar" />
      <input name="in2" type="float" nodename="alpha_075_scalar" />
    </combine2>
    <combine2 name="alpha_100" type="vector2">
      <input name="in1" type="float" nodename="alpha_100_scalar" />
      <input name="in2" type="float" nodename="alpha_100_scalar" />
    </combine2>
    <output name="roughness" type="float" nodename="active_perceptual_roughness" />
    <output name="alpha025" type="vector2" nodename="alpha_025" />
    <output name="alpha050" type="vector2" nodename="alpha_050" />
    <output name="alpha075" type="vector2" nodename="alpha_075" />
    <output name="alpha100" type="vector2" nodename="alpha_100" />
  </nodegraph>

