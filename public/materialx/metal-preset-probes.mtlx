    <multiply name="roughness_050" type="float">
      <input name="in1" type="float" nodename="active_perceptual_roughness" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <multiply name="roughness_075" type="float">
      <input name="in1" type="float" nodename="active_perceptual_roughness" />
      <input name="in2" type="float" value="0.75" />
