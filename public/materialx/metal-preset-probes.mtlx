  <!--
    Rights-safe composition of every non-image branch that contributes to the
    active Material.011 Gold preset. The shared roughness field already carries
    exact Roughness Fresnel and normalized Blender-FBM brushed semantics. This
    graph applies the active Layered Roughness=1 closure scales and mix factors.
    Anisotropy and thin-film thickness are both exactly zero in the source.

    The two active UV scratch images are deliberately absent because no
    redistribution license accompanies their packed source bytes. Their exact
    filenames, factors, dimensions, and hashes are recorded in the companion
    index. This material is therefore Gold minus those two image branches, not
    a claim of complete active-source parity.
  -->
  <nodegraph name="NG_gold_active_non_image_core">
    <multiply name="active_perceptual_roughness" type="float">
      <input name="in1" type="float" nodegraph="NG_gold_brushed_roughness_fields" output="roughness" />
      <input name="in2" type="float" value="1" />
