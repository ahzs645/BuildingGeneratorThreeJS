    </multiply>
    <add name="brushed_add" type="float">
      <input name="in1" type="float" value="0" />
      <input name="in2" type="float" nodename="brushed_noise_contribution" />
    </add>
    <multiply name="authored_base_roughness" type="float">
      <input name="in1" type="float" value="0.44999995827674866" />
      <input name="in2" type="float" nodegraph="NG_gold_roughness_fresnel_fields" output="factor" />
    </multiply>
    <subtract name="one_minus_base_roughness" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="authored_base_roughness" />
    </subtract>
    <subtract name="one_minus_brushed_add" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="brushed_add" />
    </subtract>
    <multiply name="screen_complement" type="float">
      <input name="in1" type="float" nodename="one_minus_base_roughness" />
      <input name="in2" type="float" nodename="one_minus_brushed_add" />
    </multiply>
    <subtract name="perceptual_roughness" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="screen_complement" />
    </subtract>
    <multiply name="microfacet_alpha" type="float">
      <input name="in1" type="float" nodename="perceptual_roughness" />
      <input name="in2" type="float" nodename="perceptual_roughness" />
