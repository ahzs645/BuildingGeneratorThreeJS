      <input name="in2" type="vector3" value="100, 100, 100" />
    </multiply>
    <magnitude name="mapping_length" type="float">
      <input name="in" type="vector3" nodename="mapping_scale" />
    </magnitude>
    <convert name="mapping_length_vector" type="vector3">
      <input name="in" type="float" nodename="mapping_length" />
    </convert>
    <mix name="length_mix" type="vector3">
      <input name="bg" type="vector3" nodename="mapping_scale" />
      <input name="fg" type="vector3" nodename="mapping_length_vector" />
      <input name="mix" type="float" value="0.9549999833106995" />
    </mix>
    <multiply name="noise_position" type="vector3">
      <input name="in1" type="vector3" nodename="length_mix" />
      <input name="in2" type="float" value="20" />
    </multiply>
    <fractal3d name="blender_fbm3_gold_brushed_noise" type="float">
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="3" />
      <input name="lacunarity" type="float" value="2" />
      <input name="diminish" type="float" value="0.5" />
      <input name="position" type="vector3" nodename="noise_position" />
    </fractal3d>
    <remap name="brushed_gate_unclamped" type="float">
      <input name="in" type="float" nodename="blender_fbm3_gold_brushed_noise" />
      <input name="inlow" type="float" value="0.3999999761581421" />
      <input name="inhigh" type="float" value="1" />
      <input name="outlow" type="float" value="0" />
      <input name="outhigh" type="float" value="0.27300000190734863" />
    </remap>
    <clamp name="brushed_gate" type="float">
      <input name="in" type="float" nodename="brushed_gate_unclamped" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="0.27300000190734863" />
